# Optional settings. Never commit real connection strings.
AGROSHIFT_CACHE_DIR=.cache/power
# AGROSHIFT_DATABASE_URL is a read-only reference database connection.
# AGROSHIFT_DATABASE_URL=postgresql://reference_reader:PASSWORD@HOST/DB?sslmode=verify-full
# Only the migration environment receives AGROSHIFT_IMPORT_DATABASE_URL.
# AGROSHIFT_IMPORT_DATABASE_URL=postgresql://import_admin:PASSWORD@HOST/DB?sslmode=verify-full
# A managed SQLite reference file can be selected instead.
# AGROSHIFT_KNOWLEDGE_PATH=/absolute/path/knowledge.sqlite3
# Commercial Open-Meteo place search requires a subscription.
# OPEN_METEO_API_KEY=
# The core app uses no AI API. Optional summary topic selection can use Gemini.
# GEMINI_API_KEY=
